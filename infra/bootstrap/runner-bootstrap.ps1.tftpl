$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$azureCliInstaller = Join-Path $env:TEMP "AzureCLI.msi"
Invoke-WebRequest -Uri "https://aka.ms/installazurecliwindowsx64" -OutFile $azureCliInstaller
$azureCliInstall = Start-Process -FilePath "msiexec.exe" -ArgumentList @(
  "/i",
  "`"$azureCliInstaller`"",
  "/quiet",
  "/norestart"
) -Wait -PassThru
if ($azureCliInstall.ExitCode -notin @(0, 3010)) {
  throw "Azure CLI installation failed with exit code $($azureCliInstall.ExitCode)."
}
Remove-Item -Path $azureCliInstaller -Force

$runnerRoot = "C:\actions-runner"
$runnerArchive = Join-Path $env:TEMP "actions-runner.zip"
New-Item -ItemType Directory -Path $runnerRoot -Force | Out-Null
Invoke-WebRequest `
  -Uri "https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-win-x64-${runner_version}.zip" `
  -OutFile $runnerArchive

$actualHash = (Get-FileHash -Path $runnerArchive -Algorithm SHA256).Hash.ToLowerInvariant()
if ($actualHash -ne "${runner_sha256}") {
  throw "GitHub Actions runner checksum mismatch. Expected ${runner_sha256}, got $actualHash."
}

Expand-Archive -Path $runnerArchive -DestinationPath $runnerRoot -Force
Remove-Item -Path $runnerArchive -Force
